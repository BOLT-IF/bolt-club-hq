{
  // One Worker serves the API, /healthz and the SPA (static assets) from one origin.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bolt-club-hq",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/healthz", "/healthz/*", "/api/*", "/media/*"],
  },

  // Cron Triggers: two entries (PLAN §11.3 budget), in UTC. Every UTC hour belongs to exactly one.
  // The 10-minute trigger covers Stockholm 07-23 in summer (UTC 05-21) and winter (UTC 06-22).
  // Keep in step with src/worker/scheduler/schedule.ts. See docs/DECISIONS.md (S6.4).
  "triggers": {
    "crons": ["*/10 5-22 * * *", "0 0-4,23 * * *"],
  },

  "kv_namespaces": [
    // OG preview cache and next_due_at scheduler state (PLAN §11.2).
    {
      "binding": "KV",
      "id": "68031a5b401347098df663b521a10ddf",
      "preview_id": "5ee394e1f7344bb2a60af20b848ba2a8",
    },
  ],

  "r2_buckets": [
    // Poll images, member-only (PLAN §11.1). Nothing reads MEDIA until S9.2 (images).
    { "binding": "MEDIA", "bucket_name": "bolt-club-hq-media" },
  ],

  "hyperdrive": [
    // Pooled Postgres. The id is set after `wrangler hyperdrive create`; local dev uses
    // localConnectionString, the database docker-compose creates.
    {
      "binding": "HYPERDRIVE",
      "id": "24dd32c71522408ab20f3b51c6e65417",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/club_test",
    },
  ],

  "vars": {
    "ENV": "dev",
    // Per-area feature flags, served at /api/v1/config (PLAN §11.5). "on", "true" or "1"
    // turns an area on; anything else is off. A story flips its area on when it ships.
    "FLAG_EVENTS": "off",
    "FLAG_MONEY": "off",
    "FLAG_INBOX": "off",
    "FLAG_POLLS": "off",
    // Optional. Sentry DSN for Worker error reports. Set the real value as a secret
    // (`wrangler secret put SENTRY_DSN`); unset means no reporting (see docs/DECISIONS.md, S0.7).
    // "SENTRY_DSN": "",
  },
}
